# ── 생성물 / 학습·추론 출력 (재생성 가능, git 추적 안 함) ──
/data/generated/
/data/synth/
/results/
/weights/

# ── 모델 가중치 ──
# rec_model.pdparams가 120MB라 GitHub 100MB 하드리밋에 걸려 푸시가 거부된다.
# 가중치는 학습 산출물이므로 코드 저장소에 두지 않고 별도로 공유한다.
# 실행하려면 src/parameter/ 에 det_model2.pdparams, rec_model.pdparams 를 두면 된다.
/src/parameter/
*.pdparams
*.pdopt
*.pdmodel
*.pdiparams
*.states

# ── 대용량 아카이브 ──
*.zip
*.tar
*.tar.gz

# ── 파이썬 캐시 ──
__pycache__/
*.pyc
*.pyo

# ── OS/에디터 ──
.DS_Store
Thumbs.db

# ── 개발 중 임시 파일 ──
/test.py
/.claude/worktrees/

# 실 라벨 소스 데이터(data/real)는 추적함 — 여기서 무시하지 않음
